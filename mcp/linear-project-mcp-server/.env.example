# Required Linear authentication. Use one, never commit the value.
LINEAR_API_KEY=
# LINEAR_ACCESS_TOKEN=

# Optional deployment allowlists. Comma-separated exact IDs/codes.
LINEAR_ALLOWED_ORGANIZATION_ID=
LINEAR_ALLOWED_TEAM_IDS=
LINEAR_ALLOWED_PROJECT_IDS=
LINEAR_ALLOWED_SCOPE_CODES=ACQI

# Optional GitHub evidence adapter.
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOSITORIES=Openly-Useful/example-repository

# Optional local Obsidian adapter. Must be an absolute vault path.
OBSIDIAN_VAULT_PATH=
OBSIDIAN_VAULT_NAME=
OBSIDIAN_ALLOWED_DIRECTORIES=Projects/ACQI

# Mutating tools are disabled unless explicitly enabled.
MCP_WRITES_ENABLED=false
